# Local development configuration.
# For deployment, these are set via Terraform / the deploy command.
# Decision references point at BUILD_PLAN.md.

# --- What happens to this file on deploy -------------------------------------
# The FILE does not ship, but `agents-cli deploy` reads it and turns every line
# into a deployment environment variable, visible to anyone with project access.
# So: no secrets here. GEMINI_API_KEY stays commented out and arrives from
# Secret Manager via `--secrets` instead.
#
# GOOGLE_CLOUD_PROJECT is the exception -- it is stripped as a reserved
# variable, so the deployed agent never sees it. Anything needing the project id
# must resolve it from credentials (app/config.py), not read the env var.

# --- Split billing (BUILD_PLAN 2.9) ------------------------------------------
# The goal: model calls bill prepaid AI Studio credits, while RAG Engine and
# Agent Engine bill GCP. These are separate clients, so BOTH credential paths
# must be live at once.
#
# GOOGLE_GENAI_USE_VERTEXAI switches ONLY the model calls. GOOGLE_CLOUD_PROJECT
# is still required either way -- RAG Engine and Agent Engine need ADC plus the
# project id. (The scaffold's original comment said to comment it out. Doing
# that breaks retrieval, and it presents as an auth error rather than a
# configuration choice.)

# Currently: models on Vertex. Flip to false and set GEMINI_API_KEY below to
# move model calls onto prepaid credits. Both steps, or nothing changes.
GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_API_KEY=your-api-key-here

# Required LOCALLY in both modes -- RAG Engine and Agent Engine need the project
# id. Deployed, this is stripped (see the header) and app/config.py resolves the
# project from credentials instead.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Model-serving location. "global" is correct here and is the fix for model 404s.
GOOGLE_CLOUD_LOCATION=global

# --- Retrieval (BUILD_PLAN 2.4, 2.6) -----------------------------------------
# Separate from GOOGLE_CLOUD_LOCATION on purpose: "global" is a model-serving
# value, not a valid corpus region.
RAG_CORPUS_LOCATION=us-central1

# The corpus is ephemeral, so its ID changes on every `make rag-up`. Nothing may
# hardcode an ID -- we resolve the corpus by this stable display name.
RAG_CORPUS_DISPLAY_NAME=customer-service-policies

# One corpus holding both documents, scoped per specialist in the tool layer.
# A second corpus would mean a second standing Spanner bill.
RETURNS_POLICY_DOC=tarnfield_returns_policy.pdf
PRODUCT_CATALOGUE_DOC=tarnfield_product_catalogue.pdf
BILLING_POLICY_DOC=tarnfield_billing_policy.pdf

# --- Sessions (BUILD_PLAN 2.7) -----------------------------------------------
# Deliberately NOT set here. SESSION_BACKEND and SESSION_DB_PATH default to
# sqlite and ./.sessions/sessions.db in app_utils/services.py, which is what we
# want locally -- and setting them in this file only shipped a misleading
# "SESSION_BACKEND=sqlite" into the deployed config. Deployed, Agent Runtime
# injects GOOGLE_CLOUD_AGENT_ENGINE_ID and managed sessions win before either
# variable is consulted. SQLite is never a production option anyway: Agent
# Runtime filesystems are ephemeral, so sessions would vanish between turns.


# Injected by Agent Runtime at deploy time; switches sessions and memory to
# the managed services. Do not set by hand locally.
# GOOGLE_CLOUD_AGENT_ENGINE_ID=
